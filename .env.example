# CrimeVision AI Environment Configuration
# Copy this file to .env and configure your keys if available.

# Optional AI service keys (leave blank for local forensic baseline modes)
GROQ_API_KEY=
GEMINI_API_KEY=

# Storage & Database paths (defaults to local data/ directory if omitted)
DATABASE_URL=sqlite:///data/crimevision.db
UPLOAD_DIR=data/uploads
REPORTS_DIR=data/reports

# Security & Session TTL in hours (default: 168 hours = 7 days)
SESSION_EXPIRY_HOURS=168
